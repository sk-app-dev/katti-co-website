# Sanity CMS — content backend (blog, founder, team, gallery, site settings)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=sk_your_token_here

# Email (Resend) — contact form
RESEND_API_KEY=re_your_api_key_here
CONTACT_RECIPIENT_EMAIL=your-email@example.com
CONTACT_SENDER_EMAIL=noreply@yourdomain.com

# AI Chat — Mitra (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
